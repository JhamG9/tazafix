---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CalculatorContent from '../../components/CalculatorContent.astro';
import CapacidadEndeudamientoCalculator from '../../components/calculadoras/CapacidadEndeudamientoCalculator';
---

<Layout
	title="Capacidad de endeudamiento: calculadora gratis | Cifras y Finanzas"
	description="Calcula tu capacidad de endeudamiento en Colombia: según tus ingresos y deudas actuales, descubre la cuota mensual máxima que puedes asumir en un nuevo crédito."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de capacidad de endeudamiento
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Calcula cuánto cupo mensual te queda disponible para una nueva cuota, a partir de tus
			ingresos, tus deudas actuales y el nivel de endeudamiento con el que te sientas cómodo.
		</p>

		<CapacidadEndeudamientoCalculator client:load />

		<CalculatorContent slug="capacidad-endeudamiento" />
	</section>
</Layout>
