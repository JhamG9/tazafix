---
import Layout from '../../layouts/Layout.astro';
import CapacidadEndeudamientoCalculator from '../../components/calculadoras/CapacidadEndeudamientoCalculator';
---

<Layout
	title="Calculadora de capacidad de endeudamiento — Cifras y Finanzas"
	description="Calcula cuánto cupo mensual te queda disponible para una nueva cuota según tus ingresos, tus deudas actuales y tu nivel de endeudamiento preferido."
>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/" class="text-sm font-medium text-primary hover:underline">← Volver al inicio</a>

		<h1 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
			Calculadora de capacidad de endeudamiento
		</h1>
		<p class="mt-3 max-w-2xl text-base text-ink/70">
			Calcula cuánto cupo mensual te queda disponible para una nueva cuota, a partir de tus
			ingresos, tus deudas actuales y el nivel de endeudamiento con el que te sientas cómodo.
		</p>

		<CapacidadEndeudamientoCalculator client:load />
	</section>
</Layout>
