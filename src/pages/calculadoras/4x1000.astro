---
import Layout from '../../layouts/Layout.astro';
import GravamenMovimientosCalculator from '../../components/calculadoras/GravamenMovimientosCalculator';
---

<Layout
	title="Calculadora del 4x1000 | Cifras y Finanzas"
	description="Calcula cuánto pagas de 4x1000 (Gravamen a los Movimientos Financieros) en un retiro o transferencia, y cuánto te queda neto."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/calculadoras" class="inline-flex rounded-full bg-primary/10 px-3 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-primary/15">← Todas las calculadoras</a>

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora del 4x1000
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Calcula cuánto te cobran de 4x1000 en un retiro o transferencia, y cuánto recibes neto.
		</p>

		<GravamenMovimientosCalculator client:load />
	</section>
</Layout>
