---
import Layout from '../../layouts/Layout.astro';
import InteresCompuestoCalculator from '../../components/calculadoras/InteresCompuestoCalculator';
---

<Layout
	title="Calculadora de interés compuesto — Taza Fix"
	description="Simula cuánto podría crecer tu dinero con aportes mensuales e interés compuesto a lo largo del tiempo."
>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/" class="text-sm font-medium text-primary hover:underline">← Volver al inicio</a>

		<h1 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
			Calculadora de interés compuesto
		</h1>
		<p class="mt-3 max-w-2xl text-base text-ink/70">
			Simula cuánto podría crecer tu dinero con aportes mensuales constantes. Es una simulación
			educativa, no una recomendación de inversión.
		</p>

		<InteresCompuestoCalculator client:load />
	</section>
</Layout>
