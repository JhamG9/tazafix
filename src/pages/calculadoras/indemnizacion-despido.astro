---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CalculatorContent from '../../components/CalculatorContent.astro';
import IndemnizacionDespidoCalculator from '../../components/calculadoras/IndemnizacionDespidoCalculator';
---

<Layout
	title="Indemnización por despido sin justa causa: calculadora 2026 | Cifras y Finanzas"
	description="Calcula la indemnización por despido sin justa causa en Colombia 2026 para contrato a término indefinido o fijo, según tu salario y el tiempo trabajado."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de indemnización por despido sin justa causa
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Estima la indemnización por despido sin justa causa según el artículo 64 del Código
			Sustantivo del Trabajo, para contratos a término indefinido o fijo.
		</p>

		<IndemnizacionDespidoCalculator client:load />

		<CalculatorContent slug="indemnizacion-despido" />
	</section>
</Layout>
