---
interface Props {
	showName?: boolean;
	class?: string;
}

const { showName = true, class: className = '' } = Astro.props;
---

<a href="/" class={`inline-flex items-center gap-3 ${className}`} aria-label="Cifras y Finanzas, inicio">
	<img src="/logo.svg?v=1" alt="" class="h-12 w-16 shrink-0 object-cover object-center" />
	{showName && (
		<span class="font-serif text-xl font-bold tracking-tight text-[#1F3A8A]">
			Cifras <span class="text-[#7628C9]">y Finanzas</span>
		</span>
	)}
</a>
