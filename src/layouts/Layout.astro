---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	// Excluye la página de los buscadores (por ejemplo, la 404).
	noindex?: boolean;
}

const {
	title = 'Cifras y Finanzas: calculadoras financieras de Colombia',
	description = 'Calculadoras gratis hechas para Colombia: liquidación laboral, horas extras, simulador de crédito, 4x1000, retención en la fuente y más. Cifras claras para decidir.',
	noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const esInicio = Astro.url.pathname === '/';
const schemaSitio = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: 'Cifras y Finanzas',
	url: new URL('/', Astro.site).href,
	inLanguage: 'es-CO',
};
---

<!doctype html>
<html lang="es-CO">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Cifras y Finanzas" />
		<meta property="og:locale" content="es_CO" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{esInicio && <script type="application/ld+json" set:html={JSON.stringify(schemaSitio)} />}
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
			rel="stylesheet"
		/>
		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-ZX2STFQPY0"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-ZX2STFQPY0');
		</script>
	</head>
	<body class="flex min-h-screen flex-col bg-base text-ink antialiased">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

