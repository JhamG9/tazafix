---
import Layout from '../../layouts/Layout.astro';
import GravamenMovimientosCalculator from '../../components/calculadoras/GravamenMovimientosCalculator';
---

<Layout
	title="Calculadora del 4x1000 — Cifras y Finanzas"
	description="Calcula cuánto pagas de 4x1000 (Gravamen a los Movimientos Financieros) en un retiro o transferencia, y cuánto te queda neto."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/calculadoras" class="text-sm font-medium text-primary hover:underline">← Todas las calculadoras</a>

		<h1 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
			Calculadora del 4x1000
		</h1>
		<p class="mt-3 max-w-2xl text-base text-ink/70">
			Calcula cuánto te cobran de 4x1000 en un retiro o transferencia, y cuánto recibes neto.
		</p>

		<GravamenMovimientosCalculator client:load />
	</section>
</Layout>
