---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CuotaCreditoCalculator from '../../components/calculadoras/CuotaCreditoCalculator';
---

<Layout
	title="Calculadora de cuota de crédito gratis | Cifras y Finanzas"
	description="Calcula tu cuota mensual con el sistema de amortización francés, la tasa efectiva anual o mensual vencida y valida contra la tasa de usura vigente en Colombia."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de cuota de crédito gratis
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Simula tu cuota mensual con el sistema de amortización francés (el que usan la mayoría de
			créditos de consumo e hipotecarios en Colombia) y revisa si la tasa que te ofrecen supera el
			límite legal.
		</p>

		<CuotaCreditoCalculator client:load />
	</section>
</Layout>

