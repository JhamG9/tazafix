---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CalculatorContent from '../../components/CalculatorContent.astro';
import CostoLiquidacionEmpleadorCalculator from '../../components/calculadoras/CostoLiquidacionEmpleadorCalculator';
---

<Layout
	title="Costo de un empleado para la empresa 2026: calculadora | Cifras y Finanzas"
	description="Calcula cuánto le cuesta a la empresa un trabajador en Colombia al liquidarlo: cesantías, prima, vacaciones y aportes a pensión, salud, ARL y parafiscales."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora del costo de un empleado para la empresa 2026
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Calcula cuánto le cuesta a la empresa liquidar a un trabajador: lo que le corresponde a él
			(cesantías, intereses, prima y vacaciones) más los aportes patronales a seguridad social y
			parafiscales del mismo período.
		</p>

		<CostoLiquidacionEmpleadorCalculator client:load />

		<CalculatorContent slug="costo-liquidacion-empleador" />
	</section>
</Layout>
