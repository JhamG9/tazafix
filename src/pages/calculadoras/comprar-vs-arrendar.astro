---
import Layout from '../../layouts/Layout.astro';
import CompararComprarArrendarCalculator from '../../components/calculadoras/CompararComprarArrendarCalculator';
---

<Layout
	title="Comprar vs. arrendar vivienda | Cifras y Finanzas"
	description="Compara el patrimonio que acumularías comprando vivienda con crédito hipotecario frente a arrendar e invertir la diferencia mensual, con tus propios supuestos de valorización y rentabilidad."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/calculadoras" class="inline-flex rounded-full bg-primary/10 px-3 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-primary/15">← Todas las calculadoras</a>

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Comprar vs. arrendar vivienda
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Compara cuánto patrimonio acumularías comprando vivienda con crédito hipotecario frente a
			arrendar e invertir la diferencia mensual, en el horizonte de tiempo que tú definas. Es una
			comparación informativa, no una recomendación.
		</p>

		<CompararComprarArrendarCalculator client:load />
	</section>
</Layout>
