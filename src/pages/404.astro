---
import Layout from '../layouts/Layout.astro';

const sugerencias = [
	{ label: 'Calculadora de liquidación laboral', href: '/calculadoras/liquidacion-laboral/' },
	{ label: 'Simulador de crédito', href: '/calculadoras/cuota-credito/' },
	{ label: 'Calculadora de horas extras y recargos', href: '/calculadoras/horas-extra/' },
	{ label: 'Calculadora del 4x1000', href: '/calculadoras/4x1000/' },
];
---

<Layout
	title="Página no encontrada | Cifras y Finanzas"
	description="La página que buscas no existe o cambió de dirección. Encuentra aquí todas las calculadoras de Cifras y Finanzas."
	noindex
>
	<section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
		<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">Error 404</p>
		<h1 class="mt-3 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			No encontramos esta página
		</h1>
		<p class="mx-auto mt-4 max-w-xl text-base leading-7 text-ink/65 sm:text-lg">
			Puede que el enlace esté mal escrito o que la página haya cambiado de dirección. Estas son las
			calculadoras más usadas:
		</p>

		<ul class="mt-8 flex flex-wrap justify-center gap-3">
			{
				sugerencias.map((sugerencia) => (
					<li>
						<a
							href={sugerencia.href}
							class="inline-flex rounded-full bg-primary/10 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/15"
						>
							{sugerencia.label}
						</a>
					</li>
				))
			}
		</ul>

		<a
			href="/calculadoras/"
			class="mt-10 inline-flex rounded-lg bg-primary px-5 py-3 font-medium text-surface transition-colors hover:bg-primary/90"
		>
			Ver todas las calculadoras
		</a>
	</section>
</Layout>
