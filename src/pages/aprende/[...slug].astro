---
import { existsSync } from 'node:fs';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('aprende');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

interface Props {
	entry: CollectionEntry<'aprende'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, excerpt, category, categoryLabel, metaTitle, metaDescription, faqs, image, imageAlt, imageCredit, imageSource } =
	entry.data;
// Solo mostramos la foto si el archivo ya está en public/, para no dejar imágenes rotas.
const hasImage = image ? existsSync(`public${image}`) : false;

const faqSchema =
	faqs && faqs.length > 0
		? {
				'@context': 'https://schema.org',
				'@type': 'FAQPage',
				mainEntity: faqs.map((faq) => ({
					'@type': 'Question',
					name: faq.question,
					acceptedAnswer: { '@type': 'Answer', text: faq.answer },
				})),
			}
		: null;
---

<Layout title={metaTitle} description={metaDescription}>
	<article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/aprende/" class="text-sm font-medium text-primary hover:underline">Todos los artículos</a>

		<a href={`/aprende/${category}/`} class="mt-6 inline-block text-sm font-medium uppercase tracking-wide text-primary hover:underline">
			{categoryLabel}
		</a>
		<h1 class="mt-2 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
			{title}
		</h1>
		<p class="mt-3 text-base text-ink/70">{excerpt}</p>

		{
			hasImage && (
				<figure class="mt-8">
					<img src={image} alt={imageAlt ?? ''} class="aspect-[16/9] w-full rounded-2xl object-cover" loading="eager" />
					{imageCredit && (
						<figcaption class="mt-2 text-xs text-ink/50">
							{imageSource ? <a href={imageSource} target="_blank" rel="noopener noreferrer" class="hover:underline">{imageCredit}</a> : imageCredit}
						</figcaption>
					)}
				</figure>
			)
		}

		<div
			class="prose prose-ink mt-10 max-w-none prose-headings:font-serif prose-headings:text-ink prose-p:text-ink/80 prose-strong:text-ink prose-a:text-primary prose-a:no-underline hover:prose-a:underline"
		>
			<Content />
		</div>
	</article>

	{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Layout>
