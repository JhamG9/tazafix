---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CalculatorContent from '../../components/CalculatorContent.astro';
import CuotaCreditoCalculator from '../../components/calculadoras/CuotaCreditoCalculator';
---

<Layout
	title="Simulador de crédito: calcula tu cuota mensual | Cifras y Finanzas"
	description="Simulador de crédito de libre inversión o consumo: calcula la cuota mensual, los intereses totales y la tabla de amortización con abonos a capital. Gratis."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Simulador de crédito: calcula tu cuota mensual
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Simula tu cuota mensual con el sistema de amortización francés (el que usan la mayoría de
			créditos de consumo e hipotecarios en Colombia) y revisa si la tasa que te ofrecen supera el
			límite legal.
		</p>

		<CuotaCreditoCalculator client:load />

		<CalculatorContent slug="cuota-credito" />
	</section>
</Layout>

