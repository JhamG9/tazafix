---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import RetencionFuenteCalculator from '../../components/calculadoras/RetencionFuenteCalculator';
---

<Layout
	title="Calculadora de retención en la fuente para empresas gratis | Cifras y Finanzas"
	description="Calcula la retención en la fuente en Colombia sobre salarios, compras, servicios, honorarios y arrendamientos, con las tarifas y bases vigentes."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de retención en la fuente para empresas gratis
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Calcula cuánto debe retener tu empresa según el concepto del pago: salarios, compras,
			servicios, honorarios, arrendamientos y más.
		</p>

		<RetencionFuenteCalculator client:load />
	</section>
</Layout>
