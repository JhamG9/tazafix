---
interface Props {
	showName?: boolean;
	class?: string;
}

const { showName = true, class: className = '' } = Astro.props;
---

<a href="/" class={`inline-flex items-center gap-3 ${className}`} aria-label="Cifras y Finanzas, inicio">
	<svg aria-hidden="true" viewBox="0 0 96 64" fill="none" class="h-10 w-[3.6rem] shrink-0">
		<defs>
			<linearGradient id="brand-gradient" x1="8" y1="60" x2="82" y2="10" gradientUnits="userSpaceOnUse">
				<stop stop-color="#78B8F0" />
				<stop offset="0.52" stop-color="#8498E8" />
				<stop offset="1" stop-color="#A85BE0" />
			</linearGradient>
		</defs>
		<path d="M46 15C37 9 25 11 18 19c-8 9-7 22 1 30 8 8 21 9 30 2" stroke="url(#brand-gradient)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
		<path d="M44 49 61 19c1-3 4-5 8-5h14" stroke="url(#brand-gradient)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
		<path d="M65 36h18" stroke="url(#brand-gradient)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
	</svg>
	{showName && (
		<span class="font-serif text-xl font-bold tracking-tight text-[#1F3A8A]">
			Cifras <span class="text-[#7628C9]">y Finanzas</span>
		</span>
	)}
</a>
