---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { articulosDeCategoria, categoriasBlog, getArticulos, urlCategoria } from '../../lib/aprende';

const articulos = await getArticulos();
const secciones = categoriasBlog
	.map((categoria) => ({ ...categoria, articulos: articulosDeCategoria(articulos, categoria.slug) }))
	.filter((seccion) => seccion.articulos.length > 0);
const conteo = Object.fromEntries(secciones.map((seccion) => [seccion.slug, seccion.articulos.length]));
---

<Layout
	title="Aprende: artículos de finanzas personales y empresariales en Colombia | Cifras y Finanzas"
	description="Artículos prácticos sobre vivienda, créditos, ahorro y nómina en Colombia, con cifras de 2026 y ejemplos en pesos."
>
	<section class="mx-auto max-w-7xl px-5 py-12 sm:px-8 lg:px-10 lg:py-16">
		<p class="text-sm font-bold uppercase tracking-[0.18em] text-primary">Aprende</p>
		<h1 class="mt-2 max-w-3xl font-serif text-4xl font-bold leading-tight tracking-tight text-ink sm:text-5xl">
			Artículos para tomar mejores decisiones con tu plata
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Contenido práctico, sin relleno, para entender el sistema financiero colombiano.
		</p>

		<div class="mt-8">
			<CategoryNav conteo={conteo} />
		</div>

		{
			secciones.map((seccion) => (
				<section class="mt-14" aria-labelledby={`categoria-${seccion.slug}`}>
					<div class="flex flex-wrap items-end justify-between gap-3">
						<div>
							<h2 id={`categoria-${seccion.slug}`} class="font-serif text-2xl font-bold text-ink sm:text-3xl">
								{seccion.nombre}
							</h2>
							<p class="mt-1 text-ink/65">{seccion.descripcion}</p>
						</div>
						<a href={urlCategoria(seccion.slug)} class="text-sm font-semibold text-primary hover:underline">
							Ver solo {seccion.nombre.toLowerCase()}
						</a>
					</div>
					<ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{seccion.articulos.map((articulo) => (
							<li>
								<ArticleCard articulo={articulo} />
							</li>
						))}
					</ul>
				</section>
			))
		}
	</section>
</Layout>
