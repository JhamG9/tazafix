---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CalculatorContent from '../../components/CalculatorContent.astro';
import HorasExtraCalculator from '../../components/calculadoras/HorasExtraCalculator';
---

<Layout
	title="Calculadora de horas extras y recargos 2026 Colombia | Cifras y Finanzas"
	description="Calcula el valor de la hora extra diurna y nocturna, el recargo nocturno y el dominical o festivo en Colombia 2026, con la jornada de 42 horas semanales."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de horas extras y recargos 2026
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Calcula el valor de la hora ordinaria y todos los recargos por horas extra, trabajo nocturno,
			dominical y festivo en Colombia.
		</p>

		<HorasExtraCalculator client:load />

		<CalculatorContent slug="horas-extra" />
	</section>
</Layout>
