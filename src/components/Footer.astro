---
const columns = [
	{
		title: 'Calculadoras',
		links: [
			{ label: 'Comprar vivienda', href: '/calculadoras/credito-hipotecario' },
			{ label: 'Pagar una deuda', href: '/calculadoras/cuota-credito' },
			{ label: 'Comprar carro', href: '/calculadoras/costo-carro' },
			{ label: 'Ahorrar', href: '/calculadoras/fondo-emergencia' },
			{ label: 'Invertir', href: '/calculadoras/interes-compuesto' },
		],
	},
	{
		title: 'Taza Fix',
		links: [
			{ label: 'Sobre nosotros', href: '#' },
			{ label: 'Privacidad', href: '/privacidad' },
			{ label: 'Cookies', href: '/cookies' },
		],
	},
];

const year = new Date().getFullYear();
---

<footer class="border-t border-primary/10 bg-primary text-base/90">
	<div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
		<div class="grid gap-10 sm:grid-cols-2 md:grid-cols-[1.2fr_1fr_1fr]">
			<div class="sm:col-span-2 md:col-span-1">
				<p class="font-serif text-2xl font-semibold text-surface">Taza Fix</p>
				<p class="mt-3 max-w-xs text-sm text-surface/70">
					Calculadoras y contenido financiero hechos para las reglas colombianas, no traducciones
					genéricas.
				</p>
			</div>

			{
				columns.map((column) => (
					<div>
						<h3 class="text-sm font-semibold uppercase tracking-wide text-surface/60">
							{column.title}
						</h3>
						<ul class="mt-4 space-y-2">
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										class="text-sm text-surface/80 transition-colors hover:text-surface"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div
			class="mt-10 flex flex-col gap-2 border-t border-surface/10 pt-6 text-xs text-surface/60 sm:flex-row sm:items-center sm:justify-between"
		>
			<p>&copy; {year} Taza Fix. Todos los derechos reservados.</p>
			<p>Hecho en Colombia 🇨🇴</p>
		</div>
	</div>
</footer>
