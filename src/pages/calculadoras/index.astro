---
import Layout from '../../layouts/Layout.astro';

const destacadas = [
	{
		title: 'Simulador de crédito',
		description: 'Calcula la cuota mensual de tu crédito, los intereses y la tabla de amortización.',
		tone: 'bg-[#d7eff1] text-[#1f3a8a]',
		href: '/calculadoras/cuota-credito',
	},
	{
		title: '¿Comprar o arrendar vivienda?',
		description: 'Compara el patrimonio que acumularías comprando frente a arrendar e invertir.',
		tone: 'bg-[#d7c0e8] text-[#4c2a80]',
		href: '/calculadoras/comprar-vs-arrendar',
	},
	{
		title: 'Calculadora de capacidad de endeudamiento',
		description: 'Calcula cuánto puedes pedir prestado sin ahogar tu presupuesto.',
		tone: 'bg-[#f6e1a0] text-[#725c14]',
		href: '/calculadoras/capacidad-endeudamiento',
	},
	{
		title: 'Calculadora del 4x1000',
		description: 'Calcula cuánto pagas de 4x1000 en un retiro o transferencia.',
		tone: 'bg-[#d5e8bd] text-[#376d43]',
		href: '/calculadoras/4x1000',
	},
];

const categorias = [
	{
		title: 'Créditos y deudas',
		herramientas: [
			{
				title: 'Simulador de crédito',
				description: 'Calcula la cuota mensual de tu crédito, los intereses y la tabla de amortización.',
				href: '/calculadoras/cuota-credito',
			},
			{
				title: 'Calculadora de capacidad de endeudamiento',
				description: 'Calcula cuánto puedes pedir prestado sin ahogar tu presupuesto.',
				href: '/calculadoras/capacidad-endeudamiento',
			},
			{
				title: 'Calculadora del 4x1000',
				description: 'Calcula cuánto pagas de 4x1000 en un retiro o transferencia.',
				href: '/calculadoras/4x1000',
			},
		],
	},
	{
		title: 'Vivienda',
		herramientas: [
			{
				title: 'Simulador de crédito hipotecario',
				description: 'Simula la cuota de tu crédito de vivienda en pesos, con seguros y abonos a capital.',
				href: '/calculadoras/credito-hipotecario',
			},
			{
				title: '¿Comprar o arrendar vivienda?',
				description: 'Compara el patrimonio que acumularías comprando frente a arrendar e invertir.',
				href: '/calculadoras/comprar-vs-arrendar',
			},
		],
	},
	{
		title: 'Ahorro',
		herramientas: [
			{
				title: 'Calculadora de fondo de emergencia',
				description: 'Calcula tu meta de ahorro para imprevistos y en cuántos meses puedes lograrla.',
				href: '/calculadoras/fondo-emergencia',
			},
		],
	},
	{
		title: 'Inversión',
		herramientas: [
			{
				title: 'Calculadora de interés compuesto',
				description: 'Simula cómo crece tu dinero con aportes mensuales en el tiempo.',
				href: '/calculadoras/interes-compuesto',
			},
		],
	},
	{
		title: 'Carro',
		herramientas: [
			{
				title: 'Cuánto cuesta mantener un carro',
				description: 'Descubre cuánto te cuesta tu carro al mes sumando todos los gastos asociados.',
				href: '/calculadoras/costo-carro',
			},
		],
	},
	{
		title: 'Servicios',
		herramientas: [
			{
				title: 'Calculadora de seguridad social para independientes',
				description: 'Calcula cuánto paga un independiente de salud, pensión y ARL en 2026.',
				href: '/calculadoras/aportes-independientes',
			},
			{
				title: 'Calculadora de liquidación laboral 2026',
				description: 'Calcula cuánto te corresponde como empleado: cesantías, intereses, prima y vacaciones.',
				href: '/calculadoras/liquidacion-laboral',
			},
		],
	},
	{
		title: 'Empresas',
		herramientas: [
			{
				title: 'Costo de un empleado para la empresa',
				description: 'Calcula cuánto le cuesta a la empresa un trabajador: prestaciones y aportes patronales.',
				href: '/calculadoras/costo-liquidacion-empleador',
			},
			{
				title: 'Calculadora de horas extras y recargos 2026',
				description: 'Calcula el valor de la hora extra, el recargo nocturno y el dominical o festivo.',
				href: '/calculadoras/horas-extra',
			},
			{
				title: 'Calculadora de pago por horas',
				description: 'Calcula el valor de la hora de trabajo y el pago por horas con recargos.',
				href: '/calculadoras/pago-por-horas',
			},
			{
				title: 'Indemnización por despido sin justa causa',
				description: 'Calcula la indemnización en contratos a término indefinido o fijo.',
				href: '/calculadoras/indemnizacion-despido',
			},
			{
				title: 'Calculadora de retención en la fuente 2026',
				description: 'Calcula la retención sobre salarios, compras, servicios, honorarios y arriendos.',
				href: '/calculadoras/retencion-fuente',
			},
			{
				title: 'Calculadora de incapacidad médica',
				description: 'Calcula cuánto pagan por una incapacidad y quién paga cada día.',
				href: '/calculadoras/incapacidad-laboral',
			},
			{
				title: 'Dotación laboral: quién tiene derecho',
				description: 'Verifica si un trabajador tiene derecho a dotación en 2026.',
				href: '/calculadoras/dotacion',
			},
			{
				title: 'Calculadora de licencia de maternidad y paternidad',
				description: 'Calcula las semanas y el valor de la licencia a cargo de la EPS.',
				href: '/calculadoras/licencia-maternidad-paternidad',
			},
		],
	},
];
---

<Layout
	title="Calculadoras financieras y laborales gratis (2026) | Cifras y Finanzas"
	description="Calculadoras gratis para Colombia: liquidación laboral, horas extras, simulador de crédito e hipotecario, 4x1000, retención en la fuente, seguridad social y más."
>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/" class="inline-flex rounded-full bg-primary/10 px-3 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-primary/15">← Volver al inicio</a>

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadoras financieras
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Simula tus decisiones financieras antes de tomarlas. Elige una herramienta, completa tus datos y usa el resultado como punto de partida.
		</p>

		<div class="mt-10">
			<h2 class="font-serif text-xl font-semibold text-ink sm:text-2xl">Más usadas</h2>
			<div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
				{
					destacadas.map((tool) => (
						<a
							href={tool.href}
							class={`flex flex-col gap-2 rounded-2xl ${tool.tone} p-7 shadow-sm ring-1 ring-black/5 transition-all hover:-translate-y-0.5 hover:shadow-md`}
						>
							<h3 class="font-serif text-lg font-semibold">{tool.title}</h3>
							<p class="text-sm opacity-75">{tool.description}</p>
						</a>
					))
				}
			</div>
		</div>

		<div class="mt-16 space-y-14">
			{
				categorias.map((categoria) => (
					<div>
						<h2 class="font-serif text-xl font-semibold text-ink sm:text-2xl">{categoria.title}</h2>
						<div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
							{categoria.herramientas.map((tool) => (
								<a
									href={tool.href}
									class="flex flex-col gap-2 rounded-2xl bg-surface p-6 ring-1 ring-primary/10 transition-all hover:-translate-y-0.5 hover:shadow-md"
								>
									<h3 class="font-semibold text-ink">{tool.title}</h3>
									<p class="text-sm text-ink/70">{tool.description}</p>
								</a>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>
</Layout>
