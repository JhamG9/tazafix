---
import Layout from '../../layouts/Layout.astro';
import { modalidadesCredito } from '../../data/tasasUsura';
---

<Layout
	title="Calculadora de cuota de crédito — Taza Fix"
	description="Calcula tu cuota mensual con el sistema de amortización francés, la tasa efectiva anual o mensual vencida y valida contra la tasa de usura vigente en Colombia."
>
	<section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/" class="text-sm font-medium text-primary hover:underline">← Volver al inicio</a>

		<h1 class="mt-4 font-serif text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
			Calculadora de cuota de crédito
		</h1>
		<p class="mt-3 max-w-2xl text-base text-ink/70">
			Simula tu cuota mensual con el sistema de amortización francés (el que usan la mayoría de
			créditos de consumo e hipotecarios en Colombia) y revisa si la tasa que te ofrecen supera el
			límite legal.
		</p>

		<div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,26rem)_1fr]">
			<form id="form-credito" class="h-fit rounded-2xl bg-surface p-6 shadow-sm ring-1 ring-primary/10">
				<div class="space-y-5">
					<div>
						<label for="monto" class="block text-sm font-medium text-ink">
							Monto del crédito
						</label>
						<div class="mt-1 flex items-center rounded-lg ring-1 ring-primary/20 focus-within:ring-2 focus-within:ring-primary">
							<span class="pl-3 text-ink/50">$</span>
							<input
								type="text"
								inputmode="numeric"
								id="monto"
								name="monto"
								placeholder="50.000.000"
								required
								class="w-full rounded-lg bg-transparent px-2 py-2.5 text-ink outline-none"
							/>
						</div>
					</div>

					<div>
						<span class="block text-sm font-medium text-ink">Plazo</span>
						<div class="mt-1 flex gap-2">
							<input
								type="number"
								min="1"
								id="plazo-valor"
								name="plazo-valor"
								placeholder="60"
								required
								class="w-full rounded-lg px-3 py-2.5 text-ink outline-none ring-1 ring-primary/20 focus:ring-2 focus:ring-primary"
							/>
							<select
								id="plazo-unidad"
								name="plazo-unidad"
								class="rounded-lg bg-base px-3 py-2.5 text-ink outline-none ring-1 ring-primary/20 focus:ring-2 focus:ring-primary"
							>
								<option value="meses">Meses</option>
								<option value="anios">Años</option>
							</select>
						</div>
					</div>

					<div>
						<span class="block text-sm font-medium text-ink">Tasa de interés</span>
						<div class="mt-1 flex gap-2">
							<div class="flex w-full items-center rounded-lg ring-1 ring-primary/20 focus-within:ring-2 focus-within:ring-primary">
								<input
									type="number"
									step="0.01"
									min="0"
									id="tasa-valor"
									name="tasa-valor"
									placeholder="1.5"
									required
									class="w-full rounded-lg bg-transparent px-3 py-2.5 text-ink outline-none"
								/>
								<span class="pr-3 text-ink/50">%</span>
							</div>
							<select
								id="tasa-tipo"
								name="tasa-tipo"
								class="rounded-lg bg-base px-3 py-2.5 text-ink outline-none ring-1 ring-primary/20 focus:ring-2 focus:ring-primary"
							>
								<option value="EA">E.A.</option>
								<option value="MV">M.V.</option>
							</select>
						</div>
						<p class="mt-1 text-xs text-ink/50">
							E.A. = efectiva anual · M.V. = mensual vencida (la tasa periódica que ya usas en el
							cálculo).
						</p>
					</div>

					<div>
						<label for="modalidad" class="block text-sm font-medium text-ink">
							Modalidad de crédito
						</label>
						<select
							id="modalidad"
							name="modalidad"
							class="mt-1 w-full rounded-lg bg-base px-3 py-2.5 text-ink outline-none ring-1 ring-primary/20 focus:ring-2 focus:ring-primary"
						>
							{
								modalidadesCredito.map((modalidad) => (
									<option value={modalidad.id}>{modalidad.label}</option>
								))
							}
						</select>
						<p class="mt-1 text-xs text-ink/50">
							Se usa para validar tu tasa contra la tasa de usura vigente.
						</p>
					</div>

					<button
						type="submit"
						class="w-full rounded-lg bg-primary px-4 py-3 font-medium text-surface transition-colors hover:bg-primary/90"
					>
						Calcular cuota
					</button>
				</div>
			</form>

			<div id="resultados" class="hidden">
				<div id="alerta-usura" class="mb-6 hidden rounded-xl bg-alert/10 p-4 text-sm text-alert ring-1 ring-alert/30">
				</div>

				<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
					<div class="rounded-2xl bg-primary p-6 sm:col-span-3">
						<p class="text-sm font-medium text-surface/70">Cuota mensual</p>
						<p id="cuota-mensual" class="mt-1 font-serif text-4xl font-semibold text-surface sm:text-5xl">
							$0
						</p>
					</div>

					<div class="rounded-2xl bg-surface p-5 ring-1 ring-primary/10">
						<p class="text-xs font-medium uppercase tracking-wide text-ink/60">Capital</p>
						<p id="capital-total" class="mt-1 font-serif text-xl font-semibold text-ink">$0</p>
					</div>
					<div class="rounded-2xl bg-surface p-5 ring-1 ring-primary/10">
						<p class="text-xs font-medium uppercase tracking-wide text-ink/60">Interés total</p>
						<p id="interes-total" class="mt-1 font-serif text-xl font-semibold text-alert">$0</p>
					</div>
					<div class="rounded-2xl bg-surface p-5 ring-1 ring-primary/10">
						<p class="text-xs font-medium uppercase tracking-wide text-ink/60">Total pagado</p>
						<p id="total-pagado" class="mt-1 font-serif text-xl font-semibold text-ink">$0</p>
					</div>
				</div>

				<div class="mt-8 overflow-hidden rounded-2xl ring-1 ring-primary/10">
					<div class="max-h-[28rem] overflow-auto">
						<table class="w-full min-w-[36rem] text-sm">
							<thead class="sticky top-0 bg-primary text-surface">
								<tr>
									<th class="px-3 py-3 text-center font-medium">Mes</th>
									<th class="px-3 py-3 text-right font-medium">Saldo inicial</th>
									<th class="px-3 py-3 text-right font-medium">Interés</th>
									<th class="px-3 py-3 text-right font-medium">Capital</th>
									<th class="px-3 py-3 text-right font-medium">Saldo final</th>
								</tr>
							</thead>
							<tbody id="tabla-amortizacion-body" class="bg-surface text-ink"></tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script>
	import { calcularCredito, eaAMensual, mensualAEA } from '../../lib/credito';
	import { modalidadesCredito } from '../../data/tasasUsura';

	const form = document.getElementById('form-credito') as HTMLFormElement;
	const montoInput = document.getElementById('monto') as HTMLInputElement;
	const plazoValorInput = document.getElementById('plazo-valor') as HTMLInputElement;
	const plazoUnidadSelect = document.getElementById('plazo-unidad') as HTMLSelectElement;
	const tasaValorInput = document.getElementById('tasa-valor') as HTMLInputElement;
	const tasaTipoSelect = document.getElementById('tasa-tipo') as HTMLSelectElement;
	const modalidadSelect = document.getElementById('modalidad') as HTMLSelectElement;

	const resultados = document.getElementById('resultados') as HTMLDivElement;
	const alertaUsura = document.getElementById('alerta-usura') as HTMLDivElement;
	const tablaBody = document.getElementById('tabla-amortizacion-body') as HTMLTableSectionElement;
	const cuotaMensualEl = document.getElementById('cuota-mensual') as HTMLParagraphElement;
	const capitalTotalEl = document.getElementById('capital-total') as HTMLParagraphElement;
	const interesTotalEl = document.getElementById('interes-total') as HTMLParagraphElement;
	const totalPagadoEl = document.getElementById('total-pagado') as HTMLParagraphElement;

	const currency = new Intl.NumberFormat('es-CO', {
		style: 'currency',
		currency: 'COP',
		maximumFractionDigits: 0,
	});
	const percent = new Intl.NumberFormat('es-CO', {
		style: 'percent',
		minimumFractionDigits: 2,
		maximumFractionDigits: 2,
	});
	const miles = new Intl.NumberFormat('es-CO');

	montoInput.addEventListener('input', () => {
		const digits = montoInput.value.replace(/\D/g, '');
		montoInput.value = digits ? miles.format(Number(digits)) : '';
	});

	form.addEventListener('submit', (event) => {
		event.preventDefault();

		const monto = Number(montoInput.value.replace(/\D/g, ''));
		const plazoValor = Number(plazoValorInput.value);
		const n = plazoUnidadSelect.value === 'anios' ? plazoValor * 12 : plazoValor;
		const tasaValor = Number(tasaValorInput.value) / 100;
		const tasaTipo = tasaTipoSelect.value;

		if (!monto || !n || !tasaValor) return;

		const iMensual = tasaTipo === 'EA' ? eaAMensual(tasaValor) : tasaValor;
		const eaEquivalente = tasaTipo === 'EA' ? tasaValor : mensualAEA(tasaValor);

		const resultado = calcularCredito(monto, iMensual, n);

		cuotaMensualEl.textContent = currency.format(resultado.cuotaMensual);
		capitalTotalEl.textContent = currency.format(resultado.capitalTotal);
		interesTotalEl.textContent = currency.format(resultado.interesTotal);
		totalPagadoEl.textContent = currency.format(resultado.totalPagado);

		const modalidad = modalidadesCredito.find((item) => item.id === modalidadSelect.value);
		if (modalidad && eaEquivalente > modalidad.tasaUsuraEA) {
			alertaUsura.textContent = `⚠️ La tasa ingresada equivale a ${percent.format(eaEquivalente)} E.A., por encima de la tasa de usura vigente para ${modalidad.label.toLowerCase()} (${percent.format(modalidad.tasaUsuraEA)} E.A.). Verifica las condiciones con tu entidad.`;
			alertaUsura.classList.remove('hidden');
		} else {
			alertaUsura.classList.add('hidden');
		}

		tablaBody.innerHTML = resultado.tablaAmortizacion
			.map(
				(fila) => `
					<tr class="border-b border-primary/10 last:border-0 even:bg-base/50">
						<td class="px-3 py-2 text-center">${fila.mes}</td>
						<td class="px-3 py-2 text-right">${currency.format(fila.saldoInicial)}</td>
						<td class="px-3 py-2 text-right">${currency.format(fila.interes)}</td>
						<td class="px-3 py-2 text-right">${currency.format(fila.capital)}</td>
						<td class="px-3 py-2 text-right">${currency.format(fila.saldoFinal)}</td>
					</tr>
				`
			)
			.join('');

		resultados.classList.remove('hidden');
		resultados.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>
