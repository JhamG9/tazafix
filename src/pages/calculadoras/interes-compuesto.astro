---
import Layout from '../../layouts/Layout.astro';
import BackLink from '../../components/BackLink.astro';
import CalculatorContent from '../../components/CalculatorContent.astro';
import InteresCompuestoCalculator from '../../components/calculadoras/InteresCompuestoCalculator';
---

<Layout
	title="Calculadora de interés compuesto con aportes mensuales | Cifras y Finanzas"
	description="Simula cuánto crece tu ahorro o inversión con interés compuesto: capital inicial, aportes mensuales, tasa efectiva anual y plazo. Con gráfico de crecimiento."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<BackLink />

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de interés compuesto
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Simula cuánto podría crecer tu dinero con aportes mensuales constantes. Es una simulación
			educativa, no una recomendación de inversión.
		</p>

		<InteresCompuestoCalculator client:load />

		<CalculatorContent slug="interes-compuesto" />
	</section>
</Layout>
