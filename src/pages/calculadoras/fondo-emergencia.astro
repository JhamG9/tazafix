---
import Layout from '../../layouts/Layout.astro';
import FondoEmergenciaCalculator from '../../components/calculadoras/FondoEmergenciaCalculator';
---

<Layout
	title="Calculadora de fondo de emergencia | Cifras y Finanzas"
	description="Calcula cuánto necesitas ahorrar para tu fondo de emergencia y en cuántos meses puedes lograrlo."
>
	<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
		<a href="/calculadoras" class="inline-flex rounded-full bg-primary/10 px-3 py-1.5 text-sm font-semibold text-primary transition-colors hover:bg-primary/15">← Todas las calculadoras</a>

		<h1 class="mt-6 font-serif text-4xl font-bold tracking-tight text-ink sm:text-5xl">
			Calculadora de fondo de emergencia
		</h1>
		<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
			Define una meta de ahorro clara para tus imprevistos y descubre en cuántos meses puedes
			lograrla.
		</p>

		<FondoEmergenciaCalculator client:load />
	</section>
</Layout>
