---
import BrandLogo from './BrandLogo.astro';

const navLinks = [
	{ label: 'Calcula 4x1000', href: '/calculadoras/4x1000' },
	{ label: 'Calculadoras', href: '/calculadoras' },
];
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-white/85 backdrop-blur-xl">
	<div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8 lg:px-10">
		<BrandLogo />

		<nav class="hidden items-center gap-8 md:flex">
			{
				navLinks.map((link) => (
					<a
						href={link.href}
						class="text-sm font-semibold text-ink/70 transition-colors hover:text-primary"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<button
			id="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="mobile-nav"
			aria-label="Abrir menú"
			class="flex h-10 w-10 items-center justify-center rounded-full text-primary md:hidden"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="h-6 w-6">
				<path
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					d="M4 6h16M4 12h16M4 18h16"
				></path>
			</svg>
		</button>
	</div>

	<nav id="mobile-nav" class="hidden flex-col gap-1 border-t border-primary/10 px-4 pb-4 md:hidden">
		{
			navLinks.map((link) => (
				<a
					href={link.href}
					class="rounded-lg px-3 py-2 text-sm font-medium text-ink/80 transition-colors hover:bg-primary/5 hover:text-primary"
				>
					{link.label}
				</a>
			))
		}
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const mobileNav = document.getElementById('mobile-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = mobileNav?.classList.toggle('flex');
		mobileNav?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});
</script>
