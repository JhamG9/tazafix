---
import Layout from '../layouts/Layout.astro';
import OptionIcon from '../components/OptionIcon.astro';

const categories = [
	{ label: 'Comprar vivienda', detail: 'Mi primer techo', icon: 'home', color: 'bg-[#d5e8bd]', href: '/calculadoras/credito-hipotecario' },
	{ label: 'Préstamo libre', detail: 'Vivir más tranquilo', icon: 'loan', color: 'bg-[#b9dfea]', href: '/calculadoras/cuota-credito' },
	{ label: 'Comprar carro', detail: 'Rodar en grande', icon: 'car', color: 'bg-[#f6e1a0]', href: '/calculadoras/costo-carro' },
	{ label: 'Ahorrar', detail: 'Cosechar calma', icon: 'save', color: 'bg-[#d7c0e8]', href: '/calculadoras/fondo-emergencia' },
	{ label: 'Invertir', detail: 'Ver crecer tu plata', icon: 'invest', color: 'bg-[#efa9a4]', href: '/calculadoras/interes-compuesto' },
	{ label: 'Tu patrimonio', detail: 'Tu combo financiero', icon: 'balance', color: 'bg-[#a8d8d8]', href: '/calculadoras' },
];

const categoryGroups = [
	{ title: 'Ahorro e Inversión', items: categories.slice(0, 2) },
	{ title: 'Finanzas Personales', items: categories.slice(2, 4) },
	{ title: 'Servicios', items: categories.slice(4, 6) },
];

const popularTools = [
	{
		title: '4x1000',
		description: 'Calcula el gravamen de tus movimientos.',
		icon: 'tax',
		tone: 'bg-[#d7eff1] text-[#2b7e95]',
		href: '/calculadoras/4x1000',
	},
	{
		title: 'Cuota de crédito',
		description: 'Simula tu cuota y valida contra la tasa de usura.',
		icon: 'interest',
		tone: 'bg-[#f9d1ce] text-[#b94e5d]',
		href: '/calculadoras/cuota-credito',
	},
	{
		title: 'Capacidad de endeudamiento',
		description: 'Descubre cuánto cupo tienes para una nueva cuota.',
		icon: 'balance',
		tone: 'bg-[#f7e5a8] text-[#a47915]',
		href: '/calculadoras/capacidad-endeudamiento',
	},
	{
		title: 'Comprar vs. arrendar',
		description: 'Compara el patrimonio que acumularías con cada opción.',
		icon: 'home',
		tone: 'bg-[#d6ebcb] text-[#4a9255]',
		href: '/calculadoras/comprar-vs-arrendar',
	},
	{
		title: 'Interés compuesto',
		description: 'Mira cuánto podría crecer tu dinero con aportes mensuales.',
		icon: 'invest',
		tone: 'bg-[#dfc8ee] text-[#7951a5]',
		href: '/calculadoras/interes-compuesto',
	},
	{
		title: 'Fondo de emergencia',
		description: 'Define tu meta de ahorro y en cuántos meses lograrla.',
		icon: 'save',
		tone: 'bg-[#f0cadb] text-[#b64d81]',
		href: '/calculadoras/fondo-emergencia',
	},
];

const learnArticles = [
	{
		title: '¿Qué es la UVR y cómo afecta tu crédito hipotecario?',
		excerpt: 'Entiende cómo se ajusta tu deuda en vivienda mes a mes.',
		href: '/aprende/vivienda/que-es-la-uvr-y-como-afecta-tu-credito-hipotecario',
	},
	{
		title: 'Tasa de usura: el límite legal que pocos revisan',
		excerpt: 'Aprende a identificar cuándo una tasa de interés es ilegal en Colombia.',
		href: '/aprende/creditos/tasa-de-usura-el-limite-legal-que-pocos-revisan',
	},
	{
		title: 'Ahorrar vs. invertir: por dónde empezar',
		excerpt: 'Una guía práctica para decidir qué hacer con tu primer millón.',
		href: '/aprende/ahorro/ahorrar-vs-invertir-por-donde-empezar',
	},
];
---

<Layout>
	<section id="calculadoras" class="mx-auto max-w-7xl px-5 pb-16 pt-12 sm:px-8 lg:px-10 lg:pt-16">
		<div class="mb-10 flex items-end justify-between gap-6">
			<div>
				<p class="mb-3 text-sm font-bold uppercase tracking-[0.18em] text-primary">Tu plata, a tu ritmo</p>
				<h1 class="max-w-3xl font-serif text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl">
					¿Qué quieres planear hoy?
				</h1>
				<p class="mt-4 max-w-2xl text-base leading-7 text-ink/65 sm:text-lg">
					Diseña tu futuro financiero con reglas claras, números aterrizados y herramientas hechas para Colombia.
				</p>
			</div>
			<div class="hidden rounded-2xl border border-ink/10 bg-white px-5 py-4 shadow-sm lg:block">
				<p class="text-xs font-bold uppercase tracking-wider text-ink/45">Hoy es un buen día</p>
				<p class="mt-1 text-sm font-semibold text-ink">para poner tus finanzas en orden ✦</p>
			</div>
		</div>

		<section id="herramientas" class="border-y border-ink/5 bg-white/70 py-10 sm:py-12">
			<div class="mx-auto max-w-7xl px-0">
				<div class="flex items-end justify-between gap-4">
					<div>
						<p class="text-sm font-bold uppercase tracking-[0.18em] text-ink/45">Para empezar</p>
						<h2 class="mt-2 font-serif text-3xl font-bold text-ink sm:text-4xl">Herramientas populares</h2>
					</div>
					<a href="/calculadoras" class="hidden text-sm font-bold text-primary hover:underline sm:block">Ver todas →</a>
				</div>

				<div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{
						popularTools.map((tool) => (
							<a
								href={tool.href}
								class="group flex items-center gap-3 rounded-xl bg-white px-3 py-3 shadow-sm ring-1 ring-ink/5 transition-all hover:-translate-y-0.5 hover:shadow-md"
							>
								<span class={`grid h-11 w-11 shrink-0 place-items-center rounded-xl ${tool.tone} transition-transform group-hover:scale-105`}><OptionIcon name={tool.icon} class="h-6 w-6" /></span>
								<span class="min-w-0"><h3 class="truncate font-semibold text-ink group-hover:text-primary">{tool.title}</h3><p class="truncate text-xs text-ink/55">{tool.description}</p></span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
			{
				categoryGroups.map((group) => (
					<div>
						<h2 class="font-serif text-xl font-bold text-ink sm:text-2xl">{group.title}</h2>
						<div class="mt-4 grid grid-cols-2 gap-3">
							{group.items.map((category) => (
								<a
									href={category.href}
									class={`group flex min-h-40 flex-col items-center justify-center gap-3 rounded-2xl ${category.color} p-3 text-center text-ink shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg sm:min-h-44 sm:p-4`}
								>
									<span class="opacity-90 transition-transform duration-300 group-hover:scale-110"><OptionIcon name={category.icon} class="h-14 w-14 sm:h-16 sm:w-16" /></span>
									<span>
										<strong class="block text-xs font-bold leading-tight sm:text-sm">{category.label}</strong>
										<small class="mt-1 block text-[10px] leading-tight text-ink/65 sm:text-[11px]">({category.detail})</small>
									</span>
								</a>
							))}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section id="aprende" class="bg-primary py-16">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<h2 class="font-serif text-2xl font-semibold text-surface sm:text-3xl">
				Aprende a tomar mejores decisiones
			</h2>
			<p class="mt-3 max-w-2xl text-base text-surface/70">
				Contenido práctico, sin relleno, para entender el sistema financiero colombiano.
			</p>

			<div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
				{
					learnArticles.map((article) => (
						<a
							href={article.href}
							class="flex flex-col gap-3 rounded-2xl bg-surface p-6 transition-all hover:-translate-y-0.5 hover:shadow-md"
						>
							<h3 class="font-semibold text-ink">{article.title}</h3>
							<p class="text-sm text-ink/70">{article.excerpt}</p>
							<span class="mt-auto text-sm font-medium text-primary">Leer más →</span>
						</a>
					))
				}
			</div>
		</div>
	</section>
</Layout>
